{
  "name": "movie-night",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --use-env-proxy --env-file-if-exists=.env --import tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production node --use-env-proxy --env-file-if-exists=.env --import tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "npm run build && COOKIE_SECURE=false NODE_ENV=production tsx tests/browser.smoke.ts && COOKIE_SECURE=false NODE_ENV=production tsx tests/friends.browser.ts && COOKIE_SECURE=false NODE_ENV=production tsx tests/admin.browser.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "backup": "node --env-file-if-exists=.env --import tsx scripts/backup.ts",
    "reset:picks": "node --env-file-if-exists=.env --import tsx scripts/reset-picks.ts"
  },
  "engines": {
    "node": ">=24.5.0"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
}
