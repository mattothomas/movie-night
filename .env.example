# Local development only. Copy this file to .env; .env is ignored by Git.
# In the cloud, add this token securely in environment settings instead.
TMDB_API_READ_TOKEN=
AUTH_MODE=friends
# The shared club PIN defaults to the requested three-digit code.
# FRIEND_GROUP_PIN=
# Set AUTH_MODE=accounts to restore the retained username/password flow.
# DB_PATH=data/movie-night.sqlite
# Admin/test entry codes for Matthew have the requested server defaults.
# FRIEND_ADMIN_PIN=
# FRIEND_TEST_PIN=
# AUTO_CATALOG_REFRESH_HOURS=24
# BACKUP_DIR=data/backups
